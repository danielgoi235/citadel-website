# Citadel Project Business - Environment Variables
# Copy this file to .env.local and fill in your actual values

# Site Configuration
SITE_URL=https://citadelproject.com.br
ENVIRONMENT=production

# Google Analytics
REACT_APP_GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX

# Google Search Console
REACT_APP_GOOGLE_SITE_VERIFICATION=xxxxx

# API Configuration
REACT_APP_API_URL=https://citadel-backend.onrender.com
REACT_APP_API_TIMEOUT=10000

# Google Drive Configuration
REACT_APP_GOOGLE_DRIVE_SYNC_ENABLED=true
REACT_APP_GOOGLE_DRIVE_FOLDER_ID=your_folder_id

# Super Agentes Configuration
REACT_APP_SUPER_AGENTES_AGENT_ID=cmc26zkpm002n9vzhoys499eb
REACT_APP_SUPER_AGENTES_API_KEY=your_api_key_here

# Email Configuration
REACT_APP_EMAIL_FROM=noreply@citadelproject.com.br
REACT_APP_SMTP_SERVER=smtp.resend.io

# Slack Notifications (optional)
REACT_APP_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxxxx

# LinkedIn Configuration
REACT_APP_LINKEDIN_COMPANY_ID=xxxxx

# Marketing Pixels
REACT_APP_FACEBOOK_PIXEL_ID=xxxxx
REACT_APP_LINKEDIN_INSIGHT_TAG=xxxxx
